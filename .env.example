# Public site URL used for canonical links, sitemap.xml and Open Graph tags.
# On Vercel this is detected automatically from the deployment domain.
# Set it only when you attach a custom domain, e.g. https://sanoj.dev
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the contact form.
# Create a free key at https://web3forms.com and paste it here.
# Leave empty to show the "form not configured" state.
NEXT_PUBLIC_WEB3FORMS_KEY=
